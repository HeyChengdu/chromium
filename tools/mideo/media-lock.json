  "ffmpegConfigure": [
    "--disable-everything",
    "--disable-autodetect",
    "--disable-doc",
    "--disable-debug",
    "--disable-ffplay",
    "--enable-gpl",
    "--enable-libx264",
    "--enable-zlib",
    "--enable-protocol=file,pipe,http,tcp",
    "--enable-demuxer=mov,matroska,mp3,wav,flac,image2,image2pipe,concat",
    "--enable-muxer=mp4,mov,flac,wav,null,framehash,framemd5,framecrc,md5,hash,rawvideo,image2,image2pipe,mp3",
    "--enable-decoder=h264,aac,mp3,mp3float,flac,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,png,mjpeg,rawvideo,wrapped_avframe",
    "--enable-encoder=libx264,aac,flac,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,png,mjpeg,rawvideo,wrapped_avframe,libmp3lame",
    "--enable-parser=h264,aac,mpegaudio,flac,png,mjpeg",
    "--enable-filter=aresample,aformat,anull,anullsrc,apad,atrim,asetpts,atempo,volume,amix,asplit,adelay,concat,scale,format,fps,null,trim,setpts,testsrc2,color,sine,alimiter",
    "--enable-bsf=h264_mp4toannexb,aac_adtstoasc",
    "--enable-indev=lavfi",
    "--enable-libmp3lame"
  ]
